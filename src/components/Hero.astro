---
import settings from '../../settings.json';

const { hero } = settings;
---

<section class="hero" style={`--hero-bg-opacity: ${hero.backgroundImage.opacity};`}>
  {hero.backgroundImage.enabled && (
    <div class="hero-background" style={`background-image: url(${hero.backgroundImage.src}); background-position: ${hero.backgroundImage.position};`}></div>
  )}
  <div class="container">
    <h1 class="hero-title">{hero.name}</h1>
    <p class="hero-subtitle">{hero.subtitle}</p>
    {hero.showCTA && (
      <a href={hero.ctaLink} class="hero-cta">{hero.ctaText}</a>
    )}
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding: var(--space-3xl) 0;
    text-align: center;
    overflow: hidden;
  }

  .hero-background {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-size: cover;
    background-repeat: no-repeat;
    z-index: 0;
  }

  .hero-background::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: var(--color-bg);
    opacity: calc(1 - var(--hero-bg-opacity, 0.15));
    z-index: 1;
  }

  .hero .container {
    position: relative;
    z-index: 2;
  }

  .hero-title {
    font-size: var(--font-size-3xl);
    font-weight: 700;
    margin-bottom: var(--space-md);
    color: var(--color-text);
  }

  .hero-subtitle {
    font-size: var(--font-size-lg);
    color: var(--color-text-muted);
    margin-bottom: var(--space-xl);
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  .hero-cta {
    display: inline-block;
    padding: var(--space-sm) var(--space-lg);
    background-color: var(--color-accent);
    color: white;
    border-radius: var(--border-radius);
    font-weight: 500;
    transition: background-color 0.2s ease;
  }

  .hero-cta:hover {
    background-color: var(--color-accent-hover);
    text-decoration: none;
  }

  @media (min-width: 768px) {
    .hero {
      padding: var(--space-3xl) 0 var(--space-2xl);
    }
  }
</style>
