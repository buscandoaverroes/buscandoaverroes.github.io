---
import Layout from './Layout.astro';

interface Props {
  title: string;
  description?: string;
  date: Date;
}

const { title, description, date } = Astro.props;

const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});
---

<Layout title={title}>
  <article class="essay">
    <div class="container">
      <header class="essay-header">
        <a href="/#essays" class="back-link">← Back to Essays</a>
        <h1 class="essay-title">{title}</h1>
        {description && <p class="essay-description">{description}</p>}
        <time datetime={date.toISOString()} class="essay-date">{formattedDate}</time>
      </header>

      <div class="essay-content">
        <slot />
      </div>

      <footer class="essay-footer">
        <a href="/#essays" class="back-link">← Back to Essays</a>
      </footer>
    </div>
  </article>
</Layout>

<style>
  .essay {
    padding: var(--space-3xl) 0;
  }

  .essay-header {
    margin-bottom: var(--space-3xl);
    padding-bottom: var(--space-xl);
    border-bottom: 1px solid var(--color-border);
  }

  .back-link {
    display: inline-block;
    margin-bottom: var(--space-lg);
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
    text-decoration: none;
  }

  .back-link:hover {
    color: var(--color-accent);
  }

  .essay-title {
    font-size: var(--font-size-3xl);
    margin-bottom: var(--space-md);
    line-height: var(--line-height-tight);
  }

  .essay-description {
    font-size: var(--font-size-lg);
    color: var(--color-text-muted);
    margin-bottom: var(--space-md);
    line-height: var(--line-height-base);
  }

  .essay-date {
    display: block;
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
  }

  .essay-content {
    line-height: var(--line-height-base);
  }

  /* Markdown content styling */
  .essay-content :global(h2) {
    margin-top: var(--space-2xl);
    margin-bottom: var(--space-md);
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-border);
  }

  .essay-content :global(h3) {
    margin-top: var(--space-xl);
    margin-bottom: var(--space-md);
  }

  .essay-content :global(p) {
    margin-bottom: var(--space-md);
  }

  .essay-content :global(ul),
  .essay-content :global(ol) {
    margin-bottom: var(--space-md);
    padding-left: var(--space-lg);
  }

  .essay-content :global(li) {
    margin-bottom: var(--space-xs);
  }

  .essay-content :global(code) {
    background-color: var(--color-bg-alt);
    padding: 0.2em 0.4em;
    border-radius: 3px;
    font-size: 0.9em;
    font-family: 'Monaco', 'Courier New', monospace;
  }

  .essay-content :global(pre) {
    background-color: var(--color-bg-alt);
    padding: var(--space-md);
    border-radius: var(--border-radius);
    overflow-x: auto;
    margin-bottom: var(--space-md);
  }

  .essay-content :global(pre code) {
    background-color: transparent;
    padding: 0;
  }

  .essay-content :global(blockquote) {
    border-left: 4px solid var(--color-accent);
    padding-left: var(--space-md);
    margin-left: 0;
    margin-bottom: var(--space-md);
    color: var(--color-text-muted);
    font-style: italic;
  }

  .essay-content :global(a) {
    color: var(--color-accent);
    text-decoration: underline;
  }

  .essay-content :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: var(--border-radius);
    margin: var(--space-lg) 0;
  }

  .essay-footer {
    margin-top: var(--space-3xl);
    padding-top: var(--space-xl);
    border-top: 1px solid var(--color-border);
  }

  @media (min-width: 768px) {
    .essay {
      padding: var(--space-3xl) 0 var(--space-2xl);
    }
  }
</style>
